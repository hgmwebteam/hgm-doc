# Netlify local state
.netlify

# Claude Code personal/local settings (shared settings.json IS committed)
.claude/settings.local.json

# Vendored agent skills pulled from GitHub. Reproduce with `npx skills add`
# — skills-lock.json pins the source and hash, so these are build output, not
# source. .claude/skills/supabase* are symlinks into .agents/skills/.
# Hand-written project skills (dev, ship, startworking, wrapup, …) ARE committed.
.agents/
.claude/skills/supabase
.claude/skills/supabase-postgres-best-practices

# Written by `netlify dev` when it boots the edge-function runtime. Pins
# edge.netlify.com bootstrap hashes and is regenerated on every run — local
# tooling output, not something the build needs.
deno.lock

# SOP builds (sops/tools/build.py). Already matched by `dist` above; named so
# the intent survives if that line changes.
sops/dist/
